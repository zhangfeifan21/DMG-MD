+// The native list carries shifted ghost positions. The optional GPUMD
+// geometry reads full-box coordinates without changing that list.
+struct NEPKK_PairGeometry {
+  const NEP_FLOAT* native_position;
+  const double* shifted_position;
+  const double* periodic_position;
+  double length[3];
+
+  __device__ NEP_FLOAT displacement(int i, int j, int axis) const
+  {
+    const int a = 3 * i + axis;
+    const int b = 3 * j + axis;
+    if (!periodic_position) return native_position[b] - native_position[a];
+
+    // A skin candidate can be a non-minimum-image ghost. Keep it outside
+    // the force cutoff instead of folding it into a duplicate interaction.
+    const double physical = shifted_position[b] - shifted_position[a];
+    if (fabs(physical) >= 0.5 * length[axis]) return physical;
+
+    // GPUMD 5.9.1 large-box NEP narrows the raw difference before the
+    // orthogonal minimum-image correction. The box length is float as well.
+    const float period = static_cast<float>(length[axis]);
+    float delta = static_cast<float>(periodic_position[b] - periodic_position[a]);
+    if (delta < -0.5f * period) {
+      delta += period;
+    } else if (delta > 0.5f * period) {
+      delta -= period;
+    }
+    return delta;
+  }
+};
+
+struct NEPKK_OrthoCell {
+  double origin[3];
+  double length[3];
+};
+
+static __global__ void wrap_gpumd_positions(const double* input, double* output,
+                                            int count, NEPKK_OrthoCell cell,
+                                            NEPKK_InitialFaceImages faces)
+{
+  const int index = blockIdx.x * blockDim.x + threadIdx.x;
+  if (index >= count) return;
+  const int axis = index % 3;
+  const double length = cell.length[axis];
+  const double relative = input[index] - cell.origin[axis];
+  // Most owned atoms are already in the primary box. Ghosts may be shifted
+  // by any integer number of global boxes, independent of rank boundaries.
+  double wrapped = relative;
+  if (relative < 0.0 || relative >= length) {
+    wrapped = relative - floor(relative / length) * length;
+    if (wrapped >= length) wrapped = 0.0;
+  }
+
+  if (faces.atom_mask) {
+    const int mask = faces.atom_mask[index / 3];
+    const bool use_upper = mask & faces.group_bit[axis];
+    const bool use_lower = mask & faces.group_bit[axis + 3];
+    if (use_upper != use_lower) {
+      // read_data remapping, a ghost shift, origin subtraction and primary-box
+      // recentering can each round. The face check covers those roundings;
+      // it tests only eligibility and never nudges a physical coordinate.
+      const double scale = fmax(fabs(input[index]), fmax(fabs(cell.origin[axis]), length));
+      const double margin = 4.0 * (nextafter(scale, 2.0 * scale) - scale);
+      if (margin < 0.5 * length) {
+        if (use_upper && fabs(wrapped) <= margin) {
+          wrapped += length;
+        } else if (use_lower && fabs(wrapped - length) <= margin) {
+          wrapped -= length;
+        }
+      }
+    }
+  }
+  output[index] = wrapped;
+}
